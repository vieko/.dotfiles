{
  "title": "Ctrl→Cmd editing GLOBAL",
  "rules": [
    {
      "description": "Ctrl→Cmd for editing (C/V/X/A/F/Z/Y) and common browser/app shortcuts (T/W/N/R) - exclude terminals and Zed (vim mode + integrated terminal need raw Ctrl). Strict mode preserves Shift/Option. NOTE: H/J/K/L excluded - reserved for Aerospace navigation. D/P/S excluded - Cmd+D is Spotlight and Cmd+P/Cmd+S pop dialogs; a stray Ctrl press should not.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "control"
              ]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": [
                "command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.mitchellh\\.ghostty$",
                "^dev\\.zed\\.Zed$"
              ]
            }
          ]
        },
