credentials
*.log
# Dev-repo skill symlinks are machine-local (absolute ~/dev paths differ per OS).
# Regenerate with agents/.agents/setup-skill-symlinks.sh after cloning the dev repos.
# These must live HERE, not in a .gitignore inside the skills tree: Pi's skill
# loader honors .gitignore/.ignore/.fdignore files it finds while walking
# ~/.agents/skills and would silently skip the ignored skills.
agents/.agents/skills/bonfire
agents/.agents/skills/anvil
.config/tmux/plugins/*
tmux/.config/tmux/plugins/*
cargo/.cargo/*
!cargo/.cargo/env
hypr/.config/hypr/host.conf
icons/.icons/
themes/.themes/
hypridle.conf.no_suspend
.opencode/
/.claude/
lazygit/.config/lazygit/state.yml
zed/.config/zed/prompts/prompts-library-db.*.mdb/
.DS_Store
git/.gitconfig-os
pi/.pi/agent/auth.json
pi/.pi/agent/git/
pi/.pi/agent/settings.json
pi/.pi/agent/sessions/
pi/.pi/agent/models-store.json
