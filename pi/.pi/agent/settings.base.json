{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "vercel-ai-gateway",
  "defaultModel": "anthropic/claude-opus-5.5",
  "theme": "one-dark",
  "tuiMode": "fullscreen",
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,
  "quietStartup": "header",
  "showCacheMissNotices": true,
  "editorPaddingX": 1,
  "treeFilterMode": "user-only",
  "sessionShareDestination": "gist",
  "packages": [
    "git:github.com/vieko/bonfire@v7.6.0",
    "git:github.com/vieko/pi-prose@v0.3.2",
    "git:github.com/vieko/pi-post@v0.8.1",
    "npm:pi-counsel@0.1.0",
    "npm:@vieko/pi-redact@0.1.2"
  ],
  "hideThinkingBlock": false,
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "compaction": {
    "reserveTokens": 65536
  },
  "defaultTools": [
    "+codemode"
  ]
}
