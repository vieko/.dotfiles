{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "vercel-ai-gateway",
  "defaultModel": "anthropic/claude-opus-5.5",
  "theme": "one-dark",
  "tuiMode": "fullscreen",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "vercel-ai-gateway/anthropic/claude-fable-5.2": "high",
    "vercel-ai-gateway/anthropic/claude-opus-5.5": "medium"
  },
  "enableInstallTelemetry": false,
  "quietStartup": "header",
  "showCacheMissNotices": true,
  "cacheWarming": "streaming",
  "editorPaddingX": 1,
  "treeFilterMode": "user-only",
  "sessionShareDestination": "gist",
  "packages": [
    "git:github.com/vieko/bonfire@v7.7.0",
    "git:github.com/vieko/pi-prose@v0.4.1",
    "git:github.com/vieko/pi-post@v0.9.0",
    "npm:pi-counsel@0.3.0",
    "npm:@vieko/pi-redact@0.2.0"
  ],
  "hideThinkingBlock": false,
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "defaultTools": [
    "+codemode"
  ]
}
